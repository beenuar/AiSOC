# AiSOC Environment Variables
# Copy this file to .env and fill in your values
#
# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ REQUIRED FOR LOCAL DEV — set these three before `aisoc serve`:             ║
# ║                                                                            ║
# ║   1. OPENAI_API_KEY        your LLM provider API key (see "AI / LLM")      ║
# ║   2. POSTGRES_PASSWORD     dev Postgres password (the default below works  ║
# ║                            out of the box; change for shared envs)         ║
# ║   3. AISOC_CREDENTIAL_KEY  Fernet key for the connector credential vault.  ║
# ║                            REQUIRED. Generate one (see below) — there is   ║
# ║                            no default; the app will fail to start without  ║
# ║                            it. NEVER reuse a key from anywhere public.     ║
# ║                                                                            ║
# ║ Everything else has sensible defaults for `docker compose -f               ║
# ║ infra/compose/docker-compose.dev.yml up -d`.                               ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ─── Image Pinning ────────────────────────────────────────────────────────────
# Tag pulled by every `image: ghcr.io/beenuar/aisoc-*:${AISOC_VERSION:-latest}`
# in docker-compose.yml. With `pull_policy: missing`, Docker will pull this tag
# on first boot and skip the local build (~90 s vs ~15 min). Pin to a release
# tag (e.g. v7.2.0) for reproducible deploys; leave as `latest` to track main.
AISOC_VERSION=latest

# ─── Core Configuration ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# Shared HS256 secret used ONLY for short-lived realtime WS/SSE tickets
# (Issue #239). The API mints tickets at `POST /api/v1/realtime/ticket` and the
# Node realtime service (`services/realtime`) verifies them on every WebSocket
# upgrade and SSE request — both sides MUST read the same value. This is
# intentionally separate from SECRET_KEY so the realtime edge can be rotated
# independently and a leaked ticket can never forge a full API session.
#
# Leave blank in development: both services fall back to a well-known dev secret
# so docker-compose "just works". In production you MUST set a real value —
# the ticket endpoint fails closed (503) and the realtime service rejects every
# connection until this is wired. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AISOC_REALTIME_JWT_SECRET=
# Time-to-live (seconds) for minted realtime tickets. Kept short so a leaked
# ticket is only briefly useful; the frontend re-mints on every (re)connect.
# Clamped to a 60s ceiling by the ticket endpoint regardless of this value.
AISOC_REALTIME_TICKET_TTL_SECONDS=60

# Application-layer encryption key for connector credentials and other
# secret payloads stored in Postgres. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED. There is no built-in default — generate your own key with the
# command above and paste it here. Treat this value like a database password:
# never commit it, never reuse it across environments, never share it.
AISOC_CREDENTIAL_KEY=replace-me-with-a-freshly-generated-fernet-key
# Comma-separated list of previous credential keys to support zero-downtime
# rotation. Leave blank unless you are mid-rotation.
AISOC_CREDENTIAL_KEY_ROTATION_FROM=

# Internal URL the API uses to reach the connectors microservice for
# catalog lookups and "Test connection" actions in the click-and-connect
# wizard. ``http://connectors:8003`` is correct for docker-compose;
# use ``http://localhost:8088`` when running the API on the host while
# connectors is exposed via the docker-compose port forward.
CONNECTORS_SERVICE_URL=http://connectors:8003
CONNECTORS_SERVICE_TIMEOUT_SECONDS=15

# ─── Database ─────────────────────────────────────────────────────────────────
# Two roles, and the distinction is load-bearing rather than tidy.
#
#   aisoc      owner. Superuser (the postgres image makes POSTGRES_USER one),
#              owns every table, applies the migration chain. No service
#              connects as it.
#   aisoc_app  runtime. SELECT / INSERT / UPDATE / DELETE and nothing else, so
#              that the schema's row-level-security policies apply to it. A
#              superuser ignores those policies even under FORCE ROW LEVEL
#              SECURITY, which is why running the services as `aisoc` left all
#              92 of them filtering nothing.
#
# POSTGRES_PASSWORD is the owner's; AISOC_APP_DB_PASSWORD is the runtime role's.
# Both are interpolated by docker-compose.yml, so changing them here rotates
# them across the stack. They are deliberately different values: they are
# different privilege levels.
POSTGRES_PASSWORD=aisoc_dev_secret
AISOC_APP_DB_PASSWORD=aisoc_app_dev_secret

# What every service connects as.
DATABASE_URL=postgresql+asyncpg://aisoc_app:${AISOC_APP_DB_PASSWORD}@localhost:5432/aisoc

# DDL only: `python -m app.scripts.run_migrations` uses this and nothing else
# does. Leave it unset and migrations fall back to DATABASE_URL, which is
# correct for a deployment that has not split the roles and fails loudly
# ("permission denied for schema public") on one that has.
# aisoc-db-role: owner — the migration chain applies DDL; the runtime role holds none
DATABASE_MIGRATION_URL=postgresql+asyncpg://aisoc:${POSTGRES_PASSWORD}@localhost:5432/aisoc
REDIS_URL=redis://:redis_dev_secret@localhost:6379/0
CLICKHOUSE_URL=http://aisoc:clickhouse_dev_secret@localhost:8123/aisoc

# ─── Messaging ────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Search ───────────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL affects the "explain this alert" / BYOK path only. Task workloads
# (triage, recon, investigation, copilot, summary, report, NL) request a logical
# alias instead — see the LLM gateway block below.
#
# It ships as an alias, not a concrete model, because the default deployment
# routes through the bundled gateway and the gateway 400s anything
# infra/litellm/config.yaml does not define. It used to read
# `gpt-4-turbo-preview`, which no gateway config here has ever defined, and the
# auto-triage worker treated it as a per-tenant BYOK override — so it replaced
# `aisoc-triage` on the highest-volume path in the product.
# scripts/check_llm_model_routing.py fails the build if this names a model the
# gateway does not define. Set a concrete model only when calling a provider
# directly (see "ENABLE LIVE LLM" option (b) below).
OPENAI_MODEL=aisoc-summary

# ─── LLM gateway (LiteLLM) — issue #478 ───────────────────────────────────────
# Since #478 AiSOC asks for a logical task alias (aisoc-triage,
# aisoc-investigation, …) for every live LLM call — there is no hardcoded default
# model. The alias → real-model map lives in infra/litellm/config.yaml, so you
# swap local/hosted models there without changing AiSOC. The gateway service is
# defined in docker-compose.yml.
#
# Key that AiSOC uses to authenticate to the gateway (also LiteLLM's admin key):
LITELLM_MASTER_KEY=sk-aisoc-local
# In-network URL of the gateway. docker-compose.yml sets this on the api and
# agents services, and both resolvers READ it — `resolve_base_url()` returns it
# for any aisoc-<role> alias, and `resolve_api_key()` returns LITELLM_MASTER_KEY
# to pair with it. That wire was missing: compose set this variable, the
# resolvers deliberately ignored it in favour of OPENAI_BASE_URL (which nothing
# set), and so the product's headline capability could not reach a model in the
# default deployment.
LLM_GATEWAY_URL=http://litellm:4000/v1
#
# ENABLE LIVE LLM:
#  (a) Through the gateway — the default, and already wired. Put your real
#      provider key in OPENAI_API_KEY above (the gateway reads it) and bring up
#      the `full` profile, which is where the litellm service lives:
#        docker compose --profile full up -d
#      Nothing else to set. To point at a gateway somewhere else, or to send a
#      different bearer, set OPENAI_BASE_URL/OPENAI_API_KEY and they win.
#  (b) Direct to a provider, no gateway — pin each task role to a concrete
#      model. A concrete pin is NOT rerouted to the gateway, so this keeps
#      working with LLM_GATEWAY_URL set:
#        AISOC_MODEL_PIN_TRIAGE=gpt-4o-mini
#        AISOC_MODEL_PIN_INVESTIGATION=gpt-4o
#        OPENAI_MODEL=gpt-4o-mini        # the BYOK/explain path, direct too
# With neither configured, AiSOC uses its deterministic offline path — which
# reports zero model calls and zero tokens rather than pretending to triage.

# ─── Threat Intelligence ──────────────────────────────────────────────────────
